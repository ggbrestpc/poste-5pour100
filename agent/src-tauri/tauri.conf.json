{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poste 5pour100",
  "version": "0.4.0",
  "identifier": "fr.cinqpourcent.poste",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poste 5pour100",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ggbrestpc/poste-5pour100/releases/latest/download/latest.json"],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Agent de bureau 5pour100",
    "longDescription": "Relie cet ordinateur à votre espace 5pour100 : impression de billets, notifications, partage de fichiers en classe et émargement hors-ligne."
  }
}
