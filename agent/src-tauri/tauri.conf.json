{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poste 5pour100",
  "version": "0.2.0",
  "identifier": "fr.cinqpourcent.poste",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poste 5pour100",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Agent de bureau 5pour100",
    "longDescription": "Relie cet ordinateur à votre espace 5pour100 : impression de billets, notifications, partage de fichiers en classe et émargement hors-ligne."
  }
}
